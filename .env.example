# Copy to `.env` and fill in. These are RUNTIME variables: the Docker image is built
# without them and nginx injects them into upstream requests when the container starts.
# No `VITE_` prefix — that prefix is what would inline a key into the browser bundle.

GUARDIAN_API_KEY=your-guardian-key
NYT_API_KEY=your-nyt-key
NEWSAPI_API_KEY=your-newsapi-key
